    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/U1.Business/U1.Business.csproj" />
  </ItemGroup>

</Project>
